# ============================================================
#  构建产物：可由 tools/build.ps1 重新生成，不入库
# ============================================================
build/
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*.bbl
*.blg
*.idx
*.ind
*.ilg
*.xdv

# 分片级冒烟编译会在仓库根留下 chk_<分片名>.tex
chk_*.tex

# ============================================================
#  原书页面渲染图：可由 tools/vpage.py 从源 PDF 重新生成。
#  它们是原书页面的位图副本，体积大（约 14 MB）且无独立价值。
# ============================================================
sources/pages/

# ============================================================
#  原书全文转储：可由 tools/split_chapters.py 从源 PDF 重新生成。
#  chapters/ 的写作只依赖 sources/parts/（按分片切好的源文本，已入库），
#  这两个全量转储属中间产物，且是原书文字的完整副本，不入库。
# ============================================================
sources/text/

# 页码映射与版式分析脚本的中间输出
tools/out/

# ============================================================
#  临时与编辑器
# ============================================================
tmp/
_*
*.tmp
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*

# 发布暂存区：产物以 Gitea Release 附件分发，不入库
release/

# ============================================================
#  工具运行时生成的中间产物：可由对应脚本重新生成，不入库
#  （overlap_check.py / check_terms.py / check_sources.py / qa_pdf.py 等）
# ============================================================
tools/overlap_all.txt
tools/overlap_hits.json
tools/overlap_gate.json
tools/overlap_spans.txt
tools/overlap_ctx.txt
tools/overlap_ink.txt
tools/overlap_report.md
tools/overlap_report.txt
tools/source_audit.txt
tools/term_audit.txt
tools/term_fix_log.txt
tools/qa_report.txt
tools/blackblock_report.txt
tools/*.bak

# GraphFlow tool artifacts (local only)
.graphflow/
.graphflow-cache/
graphflow-out/

# DSH task-progress events (local only)
.dsh-progress/
